#!/bin/busybox sh
# Docklet 启动脚本（ext4 可写根版；若为 squashfs 只读根自动挂 tmpfs）
MARK() { echo "Docklet: $1"; }
MARK "kernel up"

mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mkdir -p /sys/fs/cgroup
mount -t cgroup2 none /sys/fs/cgroup 2>/dev/null

# binfmt_misc（amd64）
mkdir -p /proc/sys/fs/binfmt_misc 2>/dev/null
mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null
BINFMT=/proc/sys/fs/binfmt_misc
QX86=""
for c in /usr/bin/qemu-x86_64-static /usr/bin/qemu-x86_64; do [ -x "$c" ] && QX86="$c" && break; done
if [ -d "$BINFMT" ] && [ -n "$QX86" ] && [ ! -e "$BINFMT/qemu-x86_64" ]; then
    printf ':qemu-x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:\xff\xff\xff\xff\xff\xff\xff\x00\xfe\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:%s:F\n' "$QX86" > "$BINFMT/register" 2>/dev/null
fi
[ -e "$BINFMT/qemu-x86_64" ] && MARK "binfmt amd64 ready"

# 判断根是否可写：ext4 可写则直接构建可写目录；squashfs 只读则挂 tmpfs
if touch /var/.wtest 2>/dev/null; then
    rm -f /var/.wtest
    MARK "root writable (ext4)"
    mkdir -p /var/log /var/cache /var/tmp /var/lib/containers/storage /var/run /run 2>/dev/null
else
    MARK "root readonly, mount tmpfs"
    mount -t tmpfs -o size=1536m tmpfs /var 2>/dev/null
    mkdir -p /var/log /var/cache /var/tmp /var/lib/containers/storage /var/run 2>/dev/null
    mount -t tmpfs -o size=128m tmpfs /tmp 2>/dev/null
fi

# DNS（/etc/resolv.conf 直写；ext4 可写）
DNS="$(sed -n 's/.*docklet\.dns=\([^ ]*\).*/\1/p' /proc/cmdline)"
DNS="${DNS:-1.1.1.1,8.8.8.8}"
mkdir -p /etc 2>/dev/null
printf '%s\n' "$DNS" | tr ',' '\n' > /etc/resolv.conf 2>/dev/null || \
  { mkdir -p /tmp; printf '%s\n' "$DNS" | tr ',' '\n' > /tmp/resolv.conf 2>/dev/null; }

if [ -e /dev/zram0 ]; then
    echo 536870912 > /sys/block/zram0/disksize 2>/dev/null
    mkswap /dev/zram0 >/dev/null 2>&1
    swapon /dev/zram0 2>/dev/null
fi
MARK "bootstrap done"

ip link set eth0 up 2>/dev/null
ip addr add 10.0.2.15/24 dev eth0 2>/dev/null
ip route add default via 10.0.2.2 2>/dev/null
MARK "network up"

MARK "engine starting"
export HOME=/root
podman system service --time=0 tcp://0.0.0.0:2375 >/var/log/podman.log 2>&1 &
i=0; while [ $i -lt 20 ]; do pgrep -f "podman system service" >/dev/null 2>&1 && break; /bin/busybox sleep 1; i=$((i+1)); done
echo "=== podman.log ==="; tail -8 /var/log/podman.log 2>&1
MARK "READY"

# 排障：若 podman 没立即监听，直接看端口
echo "=== port 2375 ==="; netstat -tln 2>/dev/null | grep 2375

# 保活：read 内建读 console（行模式 shell）
while read -r line; do eval "$line" 2>&1; echo "root@docklet:~# "; done
while true; do :; done
